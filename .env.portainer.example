# Never commit real values. Paste these keys into the Portainer stack environment.
DEMO_MODE=false
OPENAI_API_KEY=
OPENAI_PRIMARY_MODEL=gpt-5.6-terra

# Generate once with: openssl rand -hex 32
# Remove this variable from Portainer after both accounts exist.
SETUP_TOKEN=
JURA_AGENT_DATA_VOLUME=jura-agent-data

MONTHLY_AI_BUDGET_EUR=10
EUR_PER_USD=0.92
NEURIS_BASE_URL=https://testphase.rechtsinformationen.bund.de/v1
LEGAL_SOURCE_CACHE_TTL_SECONDS=86400

WEB_SERVICES_NETWORK=web-services
APP_URL=https://jura.example.com
