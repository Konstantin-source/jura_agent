# Never commit real values. Paste these keys into the Portainer stack environment.
DEMO_MODE=false
OPENAI_API_KEY=
OPENAI_PRIMARY_MODEL=gpt-5.6-terra

# Runtime-only aliases make one image portable between Portainer environments.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_EMAILS=person1@example.com,person2@example.com

MONTHLY_AI_BUDGET_EUR=10
EUR_PER_USD=0.92
NEURIS_BASE_URL=https://testphase.rechtsinformationen.bund.de/v1
LEGAL_SOURCE_CACHE_TTL_SECONDS=86400

WEB_SERVICES_NETWORK=web-services
APP_URL=https://jura.example.com

# Only needed for the optional dedicated cloudflared stack.
CLOUDFLARE_TUNNEL_TOKEN=
