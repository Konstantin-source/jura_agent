# Local preview. Set to false to test the persistent local database.
DEMO_MODE=true

# OpenAI (server-only)
OPENAI_API_KEY=

# Local SQLite database and private uploads. Do not commit the generated data.
DATA_DIR=.data
# Required only for the one-time /setup flow in live mode (minimum 32 characters).
SETUP_TOKEN=

# Shared budget guard
MONTHLY_AI_BUDGET_EUR=5
EUR_PER_USD=0.92

# Official legal information
NEURIS_BASE_URL=https://testphase.rechtsinformationen.bund.de/v1
LEGAL_SOURCE_CACHE_TTL_SECONDS=86400

# Public application URL
APP_URL=http://localhost:3000
