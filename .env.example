# Local preview. Set both to false in a real deployment.
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# OpenAI (server-only)
OPENAI_API_KEY=
OPENAI_PRIMARY_MODEL=gpt-5.6-terra

# Supabase (Frankfurt / eu-central-1 recommended)
# Server aliases are preferred for runtime-configured Docker images.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# NEXT_PUBLIC aliases remain supported for conventional Vercel/local builds.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_EMAILS=studentin@example.com,partner@example.com

# Shared budget guard
MONTHLY_AI_BUDGET_EUR=10
EUR_PER_USD=0.92

# Official legal information
NEURIS_BASE_URL=https://testphase.rechtsinformationen.bund.de/v1
LEGAL_SOURCE_CACHE_TTL_SECONDS=86400

# Public application URL
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
